# ---- PulseIQ8_AI ----
# Key(s) callers must send in X-Api-Key (comma-separated). Use a long random value: openssl rand -hex 32
PULSEIQ8_AI_KEYS=change-me-pulseiq8-ai
# local_only (never cloud) | local_first (cloud only as fallback, never for sensitive requests) | cloud_ok
PULSEIQ8_DATA_POLICY=local_first
PULSEIQ8_TIMEOUT=300
# port the service listens on
PORT=8092
PULSEIQ8_LLM_CLASSIFIER=false

# ---- routing switch ----
# true  = pick the tier / model per request (Fast, Coding, General, Reasoning, Vision) with fallback and escalation
# false = no routing: EVERY request goes to the one model below
PULSEIQ8_ROUTING=true
PULSEIQ8_FIXED_PROVIDER=ollama
PULSEIQ8_FIXED_MODEL=deepseek-coder-v2:16b
PULSEIQ8_FIXED_CONTEXT=16384

# ---- local models (Ollama) — change to whatever you have pulled ----
OLLAMA_BASE_URL=http://localhost:11434
FAST_MODEL=qwen3:8b
CODING_MODEL=deepseek-coder-v2:16b
GENERAL_MODEL=qwen3:8b
REASONING_MODEL=qwen3:14b
VISION_MODEL=qwen2.5vl:7b
# docker compose: models downloaded on first start (≈ 2.5 + 8.9 + 5.2 GB)
OLLAMA_MODELS="qwen3:8b deepseek-coder-v2:16b"

# ---- cloud (optional; leave empty to stay fully local). Needs DPO approval before production data. ----
ANTHROPIC_API_KEY=
ANTHROPIC_GENERAL_MODEL=
ANTHROPIC_REASONING_MODEL=
ANTHROPIC_VISION_MODEL=
ANTHROPIC_CODING_MODEL=
OPENAI_API_KEY=
OPENAI_GENERAL_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_GENERAL_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_VISION_MODEL=

# ---- Nexora AI assistant for AnalyticsIQ (web "Ask AI" + WhatsApp) ----
# The assistant has NO database access: it only calls the approved, scoped and audited tools AnalyticsIQ publishes at /api/ai/tools.
# AnalyticsIQ API. In Docker: http://host.docker.internal:8090/api
ANALYTICSIQ_URL=http://localhost:8090/api
# service key sent as X-AI-Key; must equal AI_SERVICE_KEY in AnalyticsIQ (or its PULSEIQ_AI_KEY when AI_SERVICE_KEY is not set)
ANALYTICSIQ_AI_KEY=
# true = the assistant uses local (Ollama) models only, whatever the data policy (sales data stays on this computer)
ASSISTANT_LOCAL_ONLY=true
# maximum data-tool calls per question
ASSISTANT_MAX_STEPS=6

# ---- WhatsApp (Meta WhatsApp Cloud API) → POST/GET /whatsapp/webhook ----
# any secret string; type the same value as "Verify token" in the Meta app (WhatsApp → Configuration → Webhook)
WHATSAPP_VERIFY_TOKEN=
# permanent access token of a system user with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Meta app → WhatsApp → API setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Meta app → Settings → Basic → App secret (verifies X-Hub-Signature-256; required)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_RATE_PER_MINUTE=6
