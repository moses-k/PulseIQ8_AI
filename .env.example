# ---- PulseIQ8_AI ----
# Key(s) callers must send in X-Api-Key (comma-separated). Use a long random value: openssl rand -hex 32
PULSEIQ8_AI_KEYS=change-me-pulseiq8-ai
# local_only (never cloud) | local_first (cloud only as fallback, never for sensitive requests) | cloud_ok
PULSEIQ8_DATA_POLICY=local_first
PULSEIQ8_TIMEOUT=300
# port the service listens on
PORT=8091
PULSEIQ8_LLM_CLASSIFIER=false

# ---- routing switch ----
# true  = pick the tier / model per request (Fast, Coding, General, Reasoning, Vision) with fallback and escalation
# false = no routing: EVERY request goes to the one model below
PULSEIQ8_ROUTING=true
PULSEIQ8_FIXED_PROVIDER=ollama
PULSEIQ8_FIXED_MODEL=deepseek-coder-v2:16b
PULSEIQ8_FIXED_CONTEXT=16384

# ---- local models (Ollama) — change to whatever you have pulled ----
OLLAMA_BASE_URL=http://localhost:11434
FAST_MODEL=qwen3:4b
CODING_MODEL=deepseek-coder-v2:16b
GENERAL_MODEL=qwen3:8b
REASONING_MODEL=qwen3:14b
VISION_MODEL=qwen2.5vl:7b
# docker compose: models downloaded on first start (≈ 2.5 + 8.9 + 5.2 GB)
OLLAMA_MODELS=qwen3:4b deepseek-coder-v2:16b qwen3:8b

# ---- cloud (optional; leave empty to stay fully local). Needs DPO approval before production data. ----
ANTHROPIC_API_KEY=
ANTHROPIC_GENERAL_MODEL=
ANTHROPIC_REASONING_MODEL=
ANTHROPIC_VISION_MODEL=
ANTHROPIC_CODING_MODEL=
OPENAI_API_KEY=
OPENAI_GENERAL_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_GENERAL_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_VISION_MODEL=
